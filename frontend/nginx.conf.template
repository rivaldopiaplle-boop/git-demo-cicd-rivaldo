server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Le front et l'API partagent la même origine : pas de CORS à gérer, et une
  # seule adresse à retenir pour la démonstration.
  location /api/ {
    # L'adresse de l'API vient de l'environnement : « backend » en local avec
    # docker compose, le nom du service chez l'hébergeur.
    proxy_pass ${ADRESSE_API};
    # L'en-tête Host reste celui de l'API (le comportement par défaut de nginx) :
    # chez un hébergeur comme Render, c'est lui qui aiguille vers le bon service,
    # et le nom du front l'enverrait ailleurs. En HTTPS, le nom est aussi envoyé
    # pendant la négociation TLS (SNI), sans quoi le certificat ne correspond pas.
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
