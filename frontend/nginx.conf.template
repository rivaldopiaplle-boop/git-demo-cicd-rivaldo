server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Le front et l'API partagent la même origine : pas de CORS à gérer, et une
  # seule adresse à retenir pour la démonstration.
  location /api/ {
    # L'adresse de l'API vient de l'environnement : « backend » en local avec
    # docker compose, le nom du service chez l'hébergeur.
    proxy_pass ${ADRESSE_API};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
